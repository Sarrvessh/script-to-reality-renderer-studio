# Local secrets for MoneyPrinterTurbo.
# Copy this file to .env and fill in the values there.
# .env is gitignored. Do not put real keys in this example file.
# Existing environment variables take priority over .env.
# config.toml values take priority over both.

# OpenRouter text models: https://openrouter.ai/settings/keys
# Used only when openrouter_api_key in config.toml is empty.
OPENROUTER_API_KEY=

# Free Pexels stock footage: https://www.pexels.com/api/
# Used only when pexels_api_keys in config.toml is empty.
PEXELS_API_KEY=
